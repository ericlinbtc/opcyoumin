environment         = "staging"
region              = "cn-hangzhou"
primary_zone_id     = "cn-hangzhou-h"
secondary_zone_id   = "cn-hangzhou-i"
release_sha         = "0000000000000000000000000000000000000000"
image_url           = "registry-vpc.cn-hangzhou.aliyuncs.com/youmin/web:0000000000000000000000000000000000000000"
worker_image_url    = "registry-vpc.cn-hangzhou.aliyuncs.com/youmin/worker:0000000000000000000000000000000000000000"
oss_bucket_name     = "youmin-staging-media-UNIQUE_SUFFIX"
public_origins      = ["https://staging.example.com"]
sls_project_name    = "youmin-staging-UNIQUE_SUFFIX"
rds_instance_type   = "pg.n2.2c.1m"
tair_instance_class = "redis.master.small.default"

# Supply sensitive variables through TF_VAR_* or a secrets backend:
# TF_VAR_rds_password, TF_VAR_tair_password, TF_VAR_app_environment_json
