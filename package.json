{
  "name": "youmin-opc-community",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "worker": "node --env-file-if-exists=.env.local --import tsx server/jobs/worker.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:staging:oss": "playwright test e2e/staging-media.spec.ts --project=desktop-chromium",
    "test:load": "k6 run tests/load/community-smoke.js",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx db/seed.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/bootstrap-platform-admin.ts",
    "stack:up": "docker compose up -d --wait postgres redis",
    "stack:prepare": "pnpm stack:up && pnpm db:migrate && pnpm db:seed && pnpm stack:verify",
    "stack:verify": "node --env-file-if-exists=.env.local scripts/verify-runtime-dependencies.mjs",
    "stack:down": "docker compose down",
    "env:check": "node scripts/check-environment.mjs",
    "env:check:release": "node scripts/check-environment.mjs --release",
    "config:check:core": "node --env-file-if-exists=.env.local scripts/check-runtime-config.mjs core",
    "config:check:media": "node --env-file-if-exists=.env.local scripts/check-runtime-config.mjs media",
    "config:check:production": "node --env-file-if-exists=.env.local scripts/check-runtime-config.mjs production",
    "release:verify": "node scripts/verify-deployment.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@vercel/otel": "^2.1.3",
    "ali-oss": "^6.23.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "proxy-agent": "^8.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
