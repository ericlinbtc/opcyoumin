# Application
NODE_ENV=development
APP_URL=http://localhost:3001
SESSION_COOKIE_NAME=youmin_session
SESSION_TTL_SECONDS=2592000
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
PHONE_ENCRYPTION_KEY=replace-with-32-byte-base64-key
PHONE_HASH_PEPPER=replace-with-at-least-32-random-characters
REQUEST_IP_HASH_PEPPER=replace-with-at-least-32-random-characters
TRUST_PROXY_HOPS=1

# PostgreSQL / Tair Redis
DATABASE_URL=postgres://youmin:youmin@localhost:5432/youmin
REDIS_URL=redis://localhost:6379

# Alibaba Cloud SMS
ALIYUN_REGION_ID=cn-hangzhou
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Alibaba Cloud OSS
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
MEDIA_PUBLIC_BASE_URL=https://media.opcyoumin.com

# Development only: never enable in production
SMS_DEV_CODE=246810
SMS_CODE_TTL_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_PHONE_DAILY_LIMIT=10
SMS_IP_DAILY_LIMIT=30
SMS_FAILURE_COOLDOWN_THRESHOLD=5
NEW_ACCOUNT_POST_LIMIT=3
NEW_ACCOUNT_COMMENT_LIMIT=20

# OpenTelemetry collector / Alibaba Cloud ARMS endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=youmin-web
